# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Public URL users open (the Cloudflare Tunnel hostname). The Android app signs in with this too.
APP_URL=https://tasks.example.com
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Local port for the app. Keep 127.0.0.1: only cloudflared / nginx on this VM should reach it.
HTTP_BIND=127.0.0.1
HTTP_PORT=5054

# Native MySQL on the VM
DB_DATABASE=tasks
DB_USERNAME=
DB_PASSWORD=
# Directory holding mysqld.sock on the VM:
#   Debian/Ubuntu: /var/run/mysqld   RHEL/Rocky/Alma: /var/lib/mysql (then DB_SOCKET=/var/run/mysqld/mysql.sock)
# Find it with: mysql -u root -p -e "select @@socket"
MYSQL_SOCKET_DIR=/var/run/mysqld
DB_SOCKET=/var/run/mysqld/mysqld.sock
# TCP instead of the socket: DB_SOCKET= (empty) and DB_HOST=host.docker.internal
# (MySQL must then listen on the Docker bridge and allow the user from 172.16.0.0/12)

# Email for the "Email reminder" button. Leave MAIL_MAILER=log to only write them to the log.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tasks@example.com

# Cloudflare Tunnel token (only if cloudflared runs in this stack: --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Run pending migrations when the app container starts (back up the database first!)
RUN_MIGRATIONS=true

LOG_LEVEL=warning

# Only if building is slow / stalls downloading Alpine packages: a faster mirror
# ALPINE_MIRROR=https://mirror.leaseweb.com/alpine
